<mujoco model="frustum contacts">
  <visual>
    <global offwidth="1200" offheight="600"/>
    <quality shadowsize="4096" offsamples="8"/>
    <headlight ambient=".35 .35 .35" diffuse=".5 .5 .5"/>
    <rgba contactpoint=".9 .1 .1 1" contactforce=".9 .7 .1 1"/>
  </visual>
  <asset>
    <texture type="skybox" builtin="gradient" rgb1=".4 .6 .8" rgb2="0 0 0" width="512" height="3072"/>
    <texture name="grid" type="2d" builtin="checker" rgb1=".2 .3 .4" rgb2=".1 .2 .3"
             width="512" height="512" mark="edge" markrgb=".25 .35 .45"/>
    <material name="grid" texture="grid" texrepeat="6 6" texuniform="true" reflectance=".1"/>
    <material name="blue" rgba=".25 .45 .8 .55"/>
    <material name="orange" rgba=".95 .55 .2 .55"/>
    <material name="green" rgba=".3 .7 .4 .55"/>
    <material name="box" rgba=".75 .75 .7 1"/>
  </asset>
  <worldbody>
    <light pos="0 -1 3" dir="0 .3 -1" directional="true" castshadow="true"/>
    <camera name="cam" pos="0.1 -1.15 0.75" xyaxes="1 0 0 0 .65 1" fovy="45"/>
    <geom type="plane" size="3 3 .1" material="grid"/>
    <geom type="box" size=".35 .35 .05" pos=".5 0 .05" material="box"/>

    <!-- frustum standing on the plane (analytic plane : cylinder) -->
    <body pos="-.45 0 .15">
      <freejoint/>
      <geom type="cylinder" size=".06 .15 .14" material="orange"/>
    </body>

    <!-- cone lying on its side on the plane (analytic plane : cylinder) -->
    <body pos="-.1 .1 0">
      <freejoint/>
      <geom type="cylinder" size="0 .12" fromto="0 -.3 0 0 0.288 .1176" material="green"/>
    </body>

    <!-- frustum lying on its side on a box (convex collider, multiple contacts) -->
    <body pos=".5 0 .1">
      <freejoint/>
      <geom type="cylinder" size=".05 .1" fromto="-.2 0 .05 .2 0 .1" material="blue"/>
    </body>

    <!-- cone standing on its base on a frustum standing on the box -->
    <body pos=".5 .2 .15">
      <freejoint/>
      <geom type="cylinder" size=".04 .05 .08" material="orange"/>
    </body>
    <body pos=".5 .2 .28">
      <freejoint/>
      <geom type="cylinder" size="0 .08 .04" material="green"/>
    </body>
  </worldbody>
</mujoco>

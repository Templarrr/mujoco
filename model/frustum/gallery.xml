<mujoco model="frustum gallery">
  <visual>
    <global offwidth="1600" offheight="800"/>
    <quality shadowsize="4096" offsamples="8"/>
    <headlight ambient=".3 .3 .3" diffuse=".5 .5 .5"/>
  </visual>
  <asset>
    <texture type="skybox" builtin="gradient" rgb1=".4 .6 .8" rgb2="0 0 0" width="512" height="3072"/>
    <texture name="grid" type="2d" builtin="checker" rgb1=".2 .3 .4" rgb2=".1 .2 .3"
             width="512" height="512" mark="edge" markrgb=".25 .35 .45"/>
    <material name="grid" texture="grid" texrepeat="6 6" texuniform="true" reflectance=".15"/>
    <material name="blue" rgba=".25 .45 .8 1" specular=".5" shininess=".5"/>
    <material name="orange" rgba=".95 .55 .2 1" specular=".5" shininess=".5"/>
    <material name="green" rgba=".3 .7 .4 1" specular=".5" shininess=".5"/>
    <material name="glass" rgba=".4 .7 .6 1" specular=".8" shininess=".9"/>
    <material name="wood" rgba=".6 .4 .25 1"/>
    <material name="steel" rgba=".7 .7 .75 1" specular="1" shininess=".9"/>
  </asset>
  <worldbody>
    <light pos="0 -1 3" dir="0 .3 -1" directional="true" castshadow="true"/>
    <camera name="cam" pos="0.1 -2.3 0.9" xyaxes="1 0 0 0 .35 1" fovy="45"/>
    <geom type="plane" size="3 3 .1" material="grid"/>

    <!-- cylinder: size="radius half-height" (unchanged) -->
    <geom type="cylinder" size=".15 .2" pos="-1.25 0 .2" material="blue"/>

    <!-- frustum: size="top-radius half-height bottom-radius" -->
    <geom type="cylinder" size=".08 .2 .18" pos="-.75 0 .2" material="orange"/>

    <!-- cone: top radius 0 -->
    <geom type="cylinder" size="0 .25 .17" pos="-.25 0 .25" material="green"/>

    <!-- inverted frustum: larger top -->
    <geom type="cylinder" size=".19 .15 .07" pos=".25 0 .15" material="blue"/>

    <!-- bottle: cylinder, frustum neck and cylinder, connected with fromto -->
    <geom type="cylinder" size=".12" fromto=".75 0 0 .75 0 .32" material="glass"/>
    <geom type="cylinder" size=".12 .035" fromto=".75 0 .32 .75 0 .47" material="glass"/>
    <geom type="cylinder" size=".035" fromto=".75 0 .47 .75 0 .58" material="glass"/>

    <!-- screwdriver: handle with tapered ends and a cone tip, lying on the floor -->
    <geom type="cylinder" size=".035 .055" fromto="-.55 -.55 .055 -.49 -.55 .055" material="wood"/>
    <geom type="cylinder" size=".055" fromto="-.49 -.55 .055 -.25 -.55 .055" material="wood"/>
    <geom type="cylinder" size=".055 .03" fromto="-.25 -.55 .055 -.19 -.55 .055" material="wood"/>
    <geom type="cylinder" size=".012" fromto="-.19 -.55 .055 .07 -.55 .055" material="steel"/>
    <geom type="cylinder" size=".012 0" fromto=".07 -.55 .055 .11 -.55 .055" material="steel"/>

    <!-- funnel: inverted cone and a thin spout -->
    <geom type="cylinder" size=".16 .012" fromto="1.2 -.4 .32 1.2 -.4 .14" material="orange"/>
    <geom type="cylinder" size=".012" fromto="1.2 -.4 .14 1.2 -.4 0" material="orange"/>
  </worldbody>
</mujoco>
